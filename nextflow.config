process {
    memory = '100 GB'
    time = '1d'

    withName: 'hifiasm' {
        cpus = 16
        memory = '200 GB'
    }

    withName: 'compleasm' { cpus = 8 }
    withName: 'inspector' { cpus = 8 }
}

profiles {
    coolmuc {
        process {
            executor = 'slurm'
            queue = 'biohpc_gen_normal'
            clusterOptions = '-M biohpc_gen --qos=biohpc_gen_low_prio'
        }

        conda.enabled = true
    }
}

manifest {
    defaultBranch = 'main'
    homePage = 'https://github.com/esrice/assemble-nf'
    author = 'Edward S. Ricemeyer'
    version = '0.0.1'
}
